# Copy to .env and adjust. Consumed by docker-compose.yml.

# --- Grafana ---
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin
GRAFANA_THEME=dark

# --- Prometheus ---
PROMETHEUS_RETENTION=15d

# --- OTel Collector ---
# Stamped onto every trace/metric/log as deployment.environment.
DEPLOY_ENV=local
